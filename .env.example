# MeetMind Configuration Environment Template
# Copy this file to .env and adjust variables as needed.

# Application Settings
APP_NAME=MeetMind
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security & Multi-Tenancy
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Persistence
# Local Development (Default): SQLite with WAL mode
DATABASE_URL=sqlite+aiosqlite:///./meetmind.db
# Production Example:
# DATABASE_URL=postgresql+asyncpg://meetmind_user:meetmind_password@localhost:5432/meetmind_db

# Media & Storage Settings
MEDIA_STORAGE_DIR=./storage/media
MAX_UPLOAD_SIZE_BYTES=524288000  # 500 MB
ALLOWED_MEDIA_EXTENSIONS=["mp4","webm","mov","mkv","mp3","wav","m4a"]
# Optional custom FFmpeg path (if not in PATH, will auto-detect from known locations)
FFMPEG_PATH=

# Local Speech-to-Text (ASR) Configuration
# Providers: faster_whisper, mock
ASR_PROVIDER=faster_whisper
FASTER_WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Mandatory Speaker Diarization: NVIDIA Nemotron-3-Diarization
# Providers: nemotron, mock
DIARIZATION_PROVIDER=nemotron
HUGGINGFACE_TOKEN=

# Local LLM & Meeting Intelligence Configuration
# Strict Local Policy: Uses local Ollama or deterministic rule extractor (Zero Cloud AI)
# Providers: ollama, mock
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local Embedding Configuration
# Providers: mock, sentence_transformers
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Voice Emotion Analysis (Optional)
# Providers: disabled, mock
ENABLE_VOICE_EMOTION=false
VOICE_EMOTION_PROVIDER=disabled
