# MeetMind Configuration Environment Template
# Copy this file to .env and adjust variables as needed.

# Application Settings
APP_NAME=MeetMind
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security & Multi-Tenancy
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Persistence
# Local Development (Default): SQLite with WAL mode
DATABASE_URL=sqlite+aiosqlite:///./meetmind.db
# Production Example:
# DATABASE_URL=postgresql+asyncpg://meetmind_user:meetmind_password@localhost:5432/meetmind_db

# Media & Storage Settings
MEDIA_STORAGE_DIR=./storage/media
MAX_UPLOAD_SIZE_BYTES=524288000  # 500 MB
ALLOWED_MEDIA_EXTENSIONS=["mp4","webm","mov","mkv","mp3","wav","m4a"]

# Speech-to-Text (ASR) Configuration
# Providers: mock, faster_whisper, whisper
ASR_PROVIDER=mock
FASTER_WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Speaker Diarization Configuration
# Providers: mock, pyannote
DIARIZATION_PROVIDER=mock
HUGGINGFACE_TOKEN=

# LLM & Meeting Intelligence Configuration
# Providers: mock, openai, ollama
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding Configuration
# Providers: mock, sentence_transformers, openai
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Voice Emotion Analysis (Optional)
# Providers: disabled, mock, speechbrain
ENABLE_VOICE_EMOTION=false
VOICE_EMOTION_PROVIDER=disabled

